#!/bin/bash
TARGET_COV=5
GENOME_SIZE=3100000000
OUTDIR="/work/ShallowHRD_Foundation/downsampled_5X"

mkdir -p "$OUTDIR"

# Parse all YAML files for TUMOR entries only
for YAML in /work/ShallowHRD_Foundation/tumor-paths1.yml \
             /work/ShallowHRD_Foundation/tumor-paths2.yml \
             /work/ShallowHRD_Foundation/tumor-paths3.yml; do

    grep "TUMOR" "$YAML" | while IFS=': ' read -r KEY BAM; do
        # Strip any leading/trailing whitespace from the path
        BAM=$(echo "$BAM" | xargs)
        SAMPLE=$(basename "$BAM" .bam)
        echo "Processing: $SAMPLE"

        # Skip if both output BAM and index already exist
        if [ -f "${OUTDIR}/${SAMPLE}.5X.bam" ] && [ -f "${OUTDIR}/${SAMPLE}.5X.bam.bai" ]; then
            echo "  Output already exists, skipping."
            continue
        fi

        # Check input BAM exists
        if [ ! -f "$BAM" ]; then
            echo "  WARNING: Input BAM not found: $BAM"
            continue
        fi

        # Get mapped read count
        MAPPED_READS=$(samtools flagstat "$BAM" | grep "mapped (" | awk '{print $1}')

        # Estimate read length from first 1000 reads
        READ_LEN=$(samtools view -F 4 "$BAM" | head -1000 | awk '{print length($10)}' | \
                   sort | uniq -c | sort -rn | head -1 | awk '{print $2}')

        # Calculate coverage and fraction using awk
        FRACTION=$(awk -v mapped="$MAPPED_READS" -v rlen="$READ_LEN" \
                       -v gsize="$GENOME_SIZE" -v target="$TARGET_COV" \
                   'BEGIN {
                       cov = (mapped * rlen) / gsize;
                       printf "  Estimated coverage: %.2fX\n", cov > "/dev/stderr";
                       frac = target / cov;
                       if (frac >= 1.0) print "SKIP";
                       else printf "%.6f", frac;
                   }')

        echo "  Downsample fraction: $FRACTION"

        if [ "$FRACTION" = "SKIP" ]; then
            echo "  Coverage already <= ${TARGET_COV}X, skipping downsampling."
            continue
        fi

        FRAC_DECIMAL="${FRACTION#0.}"

        samtools view -s "42.${FRAC_DECIMAL}" -b "$BAM" -o "${OUTDIR}/${SAMPLE}.5X.bam" --threads 4
        samtools index "${OUTDIR}/${SAMPLE}.5X.bam"
        echo "  Done: ${OUTDIR}/${SAMPLE}.5X.bam"
    done

done
